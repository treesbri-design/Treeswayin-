{
  "short_name": "FaithConnect",
  "name": "FaithConnect - Bible & Prayer",
  "description": "Daily Christian devotionals, scripture reader, AI-guided prayers, and spiritual journal.",
  "id": "/?source=pwa",
  "start_url": "/?tab=home",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        "/?tab=home",
        "/"
      ]
    },
    "new_tab_button": {
      "url": "/?tab=home"
    }
  },
  "orientation": "portrait-primary",
  "theme_color": "#0d4c73",
  "background_color": "#0f172a",
  "categories": [
    "lifestyle",
    "education",
    "books"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.faithconnectapp.live",
      "id": "com.faithconnectapp.live"
    },
    {
      "platform": "windows",
      "url": "https://www.microsoft.com/store/apps/9NFAITHCONNECT",
      "id": "FaithConnect.FaithConnect"
    },
    {
      "platform": "webapp",
      "url": "/manifest.json"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "iarc_rating_id": "e58c1734-7a1a-4d4a-9b48-3a817b2b6290",
