      "accept": {
        "*/*": [
          ".txt"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/?tab=prayer",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
