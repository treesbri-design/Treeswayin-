        {
          "type": "TextBlock",
          "text": "— ${verseReference}",
          "isSubtle": true,
          "weight": "Bolder",
          "horizontalAlignment": "Right"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open FaithPath",
      "url": "https://ais-pre-xgy7vrppv6jcgzzx5irpdk-387736714323.us-west2.run.app/?tab=home"
